# Porta do servidor HTTP (no Render é injetada automaticamente pela plataforma)
PORT=5000

# String de conexão do PostgreSQL (NeonDB) SEM aspas duplas ao redor do valor.
# Dica: adicione &connect_timeout=15 para suportar o cold-start (auto-suspend) do Neon Free Tier.
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# Chave secreta para assinatura dos tokens JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET=sua_chave_secreta_super_segura_com_32_caracteres_ou_mais

# URL exata do Frontend (Vercel ou localhost) para configuração do CORS (sem barra no final)
FRONTEND_URL=https://adm-estoque.vercel.app

# Credenciais do Cloudinary para upload de imagens de produtos, avatares e comprovantes
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

