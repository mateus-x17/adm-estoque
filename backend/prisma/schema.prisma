generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizacao {
  id           Int          @id @default(autoincrement())
  nome         String
  slug         String       @unique
  cnpj         String?
  telefone     String?
  ativo        Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lojas        Loja[]
  usuarios     Usuario[]
  produtos     Produto[]
  categorias   Categoria[]
  fornecedores Fornecedor[]
  pedidos      Pedido[]
  movimentos   Movimento[]

  @@index([slug])
  @@index([ativo])
}

model Loja {
  id            Int          @id @default(autoincrement())
  nome          String
  slug          String
  cnpj          String?
  telefone      String?
  endereco      String?
  ativo         Boolean      @default(true)
  organizacao   Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  usuarios      Usuario[]
  produtos      Produto[]
  categorias    Categoria[]
  fornecedores  Fornecedor[]
  pedidos       Pedido[]
  movimentos    Movimento[]

  @@unique([organizacaoId, slug])
  @@index([organizacaoId, ativo])
}

model Usuario {
  id            Int         @id @default(autoincrement())
  nome          String
  email         String
  senha         String
  role          Role        @default(OPERADOR)
  imagem        String?
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId Int
  loja          Loja?       @relation(fields: [lojaId], references: [id], onDelete: SetNull)
  lojaId        Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pedidos       Pedido[]
  movimentos    Movimento[]

  @@unique([organizacaoId, email])
  @@index([organizacaoId, email])
  @@index([organizacaoId, role])
  @@index([lojaId])
}

model Categoria {
  id            Int         @id @default(autoincrement())
  nome          String
  ativo         Boolean     @default(true)
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId Int
  loja          Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  lojaId        Int
  produtos      Produto[]

  @@unique([lojaId, nome])
  @@index([organizacaoId, lojaId, ativo])
}

model Fornecedor {
  id            Int         @id @default(autoincrement())
  nome          String
  email         String?
  telefone      String?
  endereco      String?
  ativo         Boolean     @default(true)
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId Int
  loja          Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  lojaId        Int
  produtos      Produto[]
  pedidos       Pedido[]

  @@index([organizacaoId, lojaId, ativo])
}

model Produto {
  id            Int          @id @default(autoincrement())
  nome          String
  descricao     String?
  preco         Decimal      @db.Decimal(10, 2)
  quantidade    Int          @default(0)
  imagem        String?
  ativo         Boolean      @default(true)
  organizacao   Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId Int
  loja          Loja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  lojaId        Int
  categoria     Categoria?   @relation(fields: [categoriaId], references: [id])
  categoriaId   Int?
  fornecedor    Fornecedor?  @relation(fields: [fornecedorId], references: [id])
  fornecedorId  Int?
  itensPedido   ItemPedido[]
  movimentos    Movimento[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([organizacaoId, lojaId, ativo])
  @@index([lojaId, categoriaId, quantidade])
  @@index([lojaId, fornecedorId])
  @@index([lojaId, quantidade])
  @@index([lojaId, nome])
}

model Pedido {
  id                    Int           @id @default(autoincrement())
  codigo                String
  tipo                  MovimentoTipo @default(VENDA)
  status                PedidoStatus  @default(CONCLUIDO)
  valorTotal            Decimal       @db.Decimal(10, 2)
  observacao            String?
  clienteNome           String?
  fornecedor            Fornecedor?   @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  fornecedorId          Int?
  organizacao           Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId         Int
  loja                  Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  lojaId                Int
  usuario               Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId             Int?
  vendedorRefId         Int
  vendedorNomeSnapshot  String
  vendedorEmailSnapshot String
  canceladoPorRefId     Int?
  canceladoPorNome      String?
  canceladoEm           DateTime?
  motivoCancelamento    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  itens                 ItemPedido[]
  movimentos            Movimento[]

  @@unique([organizacaoId, codigo])
  @@index([organizacaoId, lojaId, createdAt])
  @@index([organizacaoId, vendedorRefId, createdAt])
  @@index([lojaId, status, tipo, createdAt])
}

model ItemPedido {
  id                  Int     @id @default(autoincrement())
  pedido              Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId            Int
  produto             Produto @relation(fields: [produtoId], references: [id])
  produtoId           Int
  produtoNomeSnapshot String
  quantidade          Int
  precoUnitario       Decimal @db.Decimal(10, 2)
  subtotal            Decimal @db.Decimal(10, 2)

  @@index([pedidoId])
  @@index([produtoId])
}

model Movimento {
  id                    Int           @id @default(autoincrement())
  produto               Produto       @relation(fields: [produtoId], references: [id])
  produtoId             Int
  quantidade            Int
  tipo                  MovimentoTipo
  precoUnitario         Decimal       @db.Decimal(10, 2)
  valorTotal            Decimal       @db.Decimal(10, 2)
  estorno               Boolean       @default(false)
  pedido                Pedido?       @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  pedidoId              Int?
  usuario               Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId             Int?
  vendedorRefId         Int
  vendedorNomeSnapshot  String
  vendedorEmailSnapshot String
  organizacao           Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId         Int
  loja                  Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  lojaId                Int
  data                  DateTime      @default(now())
  observacao            String?

  @@index([organizacaoId, lojaId, data])
  @@index([organizacaoId, vendedorRefId, data])
  @@index([lojaId, produtoId, data])
  @@index([pedidoId])
}

enum Role {
  ADMIN
  GERENTE
  OPERADOR
}

enum MovimentoTipo {
  REPOSICAO
  VENDA
}

enum PedidoStatus {
  CONCLUIDO
  CANCELADO
}
